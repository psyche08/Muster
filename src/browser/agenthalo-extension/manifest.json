{
  "manifest_version": 3,
  "name": "Agent Halo Browser",
  "version": "0.3.0",
  "description": "Muster Agent Halo browser accessibility and the web window's fetch, via a local Rust native host.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "minimum_chrome_version": "120"
}
