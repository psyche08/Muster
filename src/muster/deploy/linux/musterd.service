# musterd on a Linux server: the device daemon with vnet and a PTY terminal.
# Installed by scripts/install-linux.sh; edit /etc/muster/musterd.env for
# MUSTER_RELAY (host:port) and MUSTER_NAME.
[Unit]
Description=Muster device daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/muster/musterd.env
Environment=MUSTER_DIR=/var/lib/muster RUST_LOG=info
ExecStart=/opt/muster/bin/musterd --dir /var/lib/muster --relay ${MUSTER_RELAY} --name ${MUSTER_NAME} --kind server --vnet --no-agent --terminal pty --authorized-keys /etc/muster/authorized_keys
Restart=always
RestartSec=2
# TUN creation and routes need CAP_NET_ADMIN; everything else runs unprivileged.
User=root
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/muster /etc/muster
PrivateTmp=true

[Install]
WantedBy=multi-user.target
