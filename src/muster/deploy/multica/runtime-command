#!/bin/sh
# Framing only: Rust owns routing, provider protocol and authorization.
set -eu
provider="${MUSTER_RUNTIME_PROVIDER:?missing runtime provider}"
case "$provider" in codex|claude) ;; *) exit 2 ;; esac
for arg in "$@"; do
  case "$arg" in --version|-v|version)
    cat "${MUSTER_BRIDGE_VERSION_FILE:?missing runtime version}"
    printf '\n'
    exit 0 ;;
  esac
done
TOKEN="${MUSTER_BRIDGE_TOKEN:?missing bridge token}"
# Own both transport and stdin relay. A foreground pipeline waits for cat even
# after socat fails, leaving the scheduler stuck until its idle watchdog.
pipe_dir=$(mktemp -d)
transport_pid=
input_pid=
cleanup() {
  trap - EXIT HUP INT TERM
  for pid in "$input_pid" "$transport_pid"; do
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
  done
  rm -f "$pipe_dir/input"
  rmdir "$pipe_dir"
}
trap cleanup EXIT
trap '' PIPE
trap 'exit 130' HUP INT TERM
mkfifo "$pipe_dir/input"
socat - "TCP:${MUSTER_BRIDGE_HOST:?}:${MUSTER_BRIDGE_PORT:?},connect-timeout=5" < "$pipe_dir/input" &
transport_pid=$!
exec 3>"$pipe_dir/input"
{
  printf '%s\n%s\n%s\n' "$TOKEN" MUSTER_NATIVE_V1 "$provider"
  printf '%s' "$PWD" | base64 -w0
  printf '\n%s\n' "$#"
  for arg in "$@"; do printf '%s' "$arg" | base64 -w0; printf '\n'; done
  env | grep '^MULTICA_' || true
  printf '\n'
} >&3 || true
exec 4<&0
cat <&4 >&3 &
input_pid=$!
exec 3>&- 4<&-
status=0
wait "$transport_pid" || status=$?
transport_pid=
exit "$status"
