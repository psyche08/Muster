#!/bin/sh
# Framing only: Rust owns routing, provider protocol and authorization.
set -eu
provider="${MUSTER_RUNTIME_PROVIDER:?missing runtime provider}"
case "$provider" in codex|claude) ;; *) exit 2 ;; esac
for arg in "$@"; do
  case "$arg" in --version|-v|version)
    cat "${MUSTER_BRIDGE_VERSION_FILE:?missing runtime version}"
    printf '\n'
    exit 0 ;;
  esac
done
TOKEN="${MUSTER_BRIDGE_TOKEN:?missing bridge token}"
{
  printf '%s\n%s\n%s\n' "$TOKEN" MUSTER_NATIVE_V1 "$provider"
  printf '%s' "$PWD" | base64 -w0
  printf '\n%s\n' "$#"
  for arg in "$@"; do printf '%s' "$arg" | base64 -w0; printf '\n'; done
  env | grep '^MULTICA_' || true
  printf '\n'
  cat
} | socat - "TCP:${MUSTER_BRIDGE_HOST:?}:${MUSTER_BRIDGE_PORT:?}"
