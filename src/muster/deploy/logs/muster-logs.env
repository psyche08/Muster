# /etc/muster/logs.env — the log collector (ADR 0228).
LOGS_LISTEN=0.0.0.0:9444
# The relay's certificate generation (deploy/relay/renew-cert.sh).
LOGS_CERT=/etc/muster/relay-tls/current/fullchain.pem
LOGS_KEY=/etc/muster/relay-tls/current/privkey.pem
# Day directories older than this are deleted (the privacy page says 30).
LOGS_RETENTION_DAYS=30
# Compressed MiB one device may add per UTC day.
LOGS_DEVICE_DAILY_MIB=128
