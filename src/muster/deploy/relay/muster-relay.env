# /etc/muster/relay.env — one public port, two certificate-verified carriers.
RELAY_LISTEN=0.0.0.0:9443
RELAY_CERT=/etc/muster/relay-tls/current/fullchain.pem
RELAY_KEY=/etc/muster/relay-tls/current/privkey.pem
RELAY_MAX_CLIENTS=10000
RELAY_CLIENT_PPS=3000
RELAY_CLIENT_BPS=30000000
RELAY_SOURCE_PPS=30
RELAY_MAILBOX_ITEMS=512
RELAY_MAILBOX_KEYS=10000
RELAY_IDLE_SECS=90
# Optional APNs/FCM push hook, passed device id, kind and opaque token.
#RELAY_PUSH_ARGS=--push-command /opt/muster/bin/muster-apns-push --push-interval-secs 600  (deploy/apns)
RELAY_PUSH_ARGS=
