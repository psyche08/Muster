new file mode 100644
index 0000000..edc3ec8
--- /dev/null
+++ b/Sources/Services/RuntimeLinux/Server/ProcessExitRegistry.swift
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: Apache-2.0
+import Containerization
+
+/// Actor-confined. Live waiters are never evicted; only recent exit values
+/// survive completion, so a late wait cannot retain a process or RPC client.
+struct ProcessExitRegistry {
+    private(set) var pending: [String: [CheckedContinuation<ExitStatus, Never>]] = [:]
+    private(set) var completed: [String: ExitStatus] = [:]
+    private var order: [String] = []
+    let limit: Int
+
+    init(limit: Int = 1024) {
+        precondition(limit > 0)
+        self.limit = limit
+    }
+
+    mutating func register(_ id: String) -> Bool {
+        guard pending[id] == nil, completed[id] == nil else { return false }
+        pending[id] = []
+        return true
+    }
+
+    mutating func wait(_ id: String, _ continuation: CheckedContinuation<ExitStatus, Never>) {
+        if let status = completed[id] {
+            continuation.resume(returning: status)
+        } else if pending[id] != nil {
+            pending[id]!.append(continuation)
+        } else {
+            continuation.resume(returning: ExitStatus(exitCode: -1))
+        }
+    }
+
+    mutating func complete(_ id: String, status: ExitStatus) {
+        guard let waiting = pending.removeValue(forKey: id) else { return }
+        completed[id] = status
+        order.append(id)
+        if order.count > limit {
+            completed.removeValue(forKey: order.removeFirst())
+        }
+        for continuation in waiting { continuation.resume(returning: status) }
+    }
+}
