diff --git a/Tests/ContainerRuntimeLifecycleTests/ProcessExitRegistryTests.swift b/Tests/ContainerRuntimeLifecycleTests/ProcessExitRegistryTests.swift
new file mode 100644
index 0000000..4ba253b
--- /dev/null
+++ b/Tests/ContainerRuntimeLifecycleTests/ProcessExitRegistryTests.swift
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0
+import Containerization
+import Foundation
+import Testing
+@testable import ContainerRuntimeLinuxServer
+@testable import ContainerRuntimeClient
+
+struct ProcessExitRegistryTests {
+    @Test func earlyAndLateWaitsPreserveExitStatus() async {
+        var exits = ProcessExitRegistry(limit: 2)
+        let firstRegistered = exits.register("first")
+        #expect(firstRegistered)
+        let early = await withCheckedContinuation { continuation in
+            exits.wait("first", continuation)
+            exits.complete("first", status: ExitStatus(exitCode: 37))
+            // Duplicate notifications cannot resume a continuation twice.
+            exits.complete("first", status: ExitStatus(exitCode: 99))
+        }
+        #expect(early.exitCode == 37)
+        let late = await withCheckedContinuation { exits.wait("first", $0) }
+        #expect(late.exitCode == 37)
+        #expect(exits.pending.isEmpty)
+    }
+
+    @Test func historyIsBoundedWithoutEvictingLiveWaiters() async {
+        var exits = ProcessExitRegistry(limit: 2)
+        let liveRegistered = exits.register("live")
+        #expect(liveRegistered)
+        for i in 0..<1000 {
+            let id = "exec-\(i)"
+            let registered = exits.register(id)
+            #expect(registered)
+            exits.complete(id, status: ExitStatus(exitCode: 0))
+        }
+        #expect(exits.completed.count == 2)
+        #expect(exits.pending.count == 1)
+        let expired = await withCheckedContinuation { exits.wait("exec-0", $0) }
+        #expect(expired.exitCode == -1)
+        let live = await withCheckedContinuation { continuation in
+            exits.wait("live", continuation)
+            exits.complete("live", status: ExitStatus(exitCode: 42))
+        }
+        #expect(live.exitCode == 42)
+        #expect(exits.pending.isEmpty)
+    }
+
+    @Test func concurrentWaitersAllResume() async {
+        actor Registry {
+            var exits = ProcessExitRegistry()
+            init() { _ = exits.register("task") }
+            func wait() async -> Int32 {
+                await withCheckedContinuation { exits.wait("task", $0) }.exitCode
+            }
+            func complete() { exits.complete("task", status: ExitStatus(exitCode: 7)) }
+            var waiters: Int { exits.pending["task"]?.count ?? 0 }
+        }
+        let registry = Registry()
+        let first = Task { await registry.wait() }
+        let second = Task { await registry.wait() }
+        let deadline = ContinuousClock.now.advanced(by: .seconds(5))
+        while await registry.waiters < 2 && ContinuousClock.now < deadline {
+            await Task.yield()
+        }
+        #expect(await registry.waiters == 2)
+        await registry.complete()
+        #expect(await first.value == 7)
+        #expect(await second.value == 7)
+    }
+
+    @Test(arguments: [0, 1, 2, 3])
+    func monitorReleasesCompletedTasksAndCallsCallbackOnce(mode: Int) async throws {
+        enum Failure: Error { case expected }
+        actor Calls {
+            var count = 0
+            func record() { count += 1 }
+        }
+        let monitor = ExitMonitor()
+        let calls = Calls()
+        for i in 0..<100 {
+            let id = "exec-\(i)"
+            try await monitor.registerProcess(id: id) { _, status in
+                #expect(status.exitCode == (mode & 1 == 1 ? -1 : 0))
+                await calls.record()
+                if mode & 2 == 2 { throw Failure.expected }
+            }
+            try await monitor.track(id: id) {
+                if mode & 1 == 1 { throw Failure.expected }
+                return ExitStatus(exitCode: 0)
+            }
+        }
+        let deadline = ContinuousClock.now.advanced(by: .seconds(5))
+        while await monitor.trackedProcessCount > 0 && ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(1))
+        }
+        #expect(await monitor.trackedProcessCount == 0)
+        #expect(await monitor.registeredCallbackCount == 0)
+        #expect(await calls.count == 100)
+    }
+    @Test func stdinStreamClearsItsHandlerAfterCancellation() async throws {
+        let pipe = Pipe()
+        let reader = pipe.fileHandleForReading
+        let stream = reader.stream()
+        let task = Task { for await _ in stream {} }
+        task.cancel()
+        await task.value
+        #expect(reader.readabilityHandler == nil)
+        try reader.close()
+        try pipe.fileHandleForWriting.close()
+    }
+
+}
